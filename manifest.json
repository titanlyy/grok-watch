{
  "manifest_version": 3,
  "name": "Grok Watch",
  "version": "1.2.0",
  "description": "Cyberpunk Grok usage popup, with an optional floating panel on grok.com.",
  "permissions": ["storage"],
  "host_permissions": ["https://grok.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://grok.com/*"],
      "js": ["content-script.js", "panel.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Grok Watch",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
